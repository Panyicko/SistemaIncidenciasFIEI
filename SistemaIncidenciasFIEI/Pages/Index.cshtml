@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">SIGPI FIEI</h1>
        <p class="col-md-9 fs-5">
            Sistema de Gestión y Priorización de Incidencias Tecnológicas.
            Reporta problemas en salones, laboratorios y equipos para que
            el personal pueda organizar su atención.
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Reportar un problema</h2>
                <p class="card-text">
                    Registra una falla e indica dónde ocurre y cuánto afecta.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Seguimiento</h2>
                <p class="card-text">
                    Consulta si el reporte está pendiente, programado o resuelto.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Atención técnica</h2>
                <p class="card-text">
                    El personal registra visitas, reparaciones y cambios de estado.
                </p>
            </div>
        </div>
    </div>
</div>